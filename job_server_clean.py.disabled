    print(f"Created {len(JOBS_STORAGE)} sample jobs")

def save_jobs_to_file():
    """Save current jobs to file"""
    try:
        os.makedirs('data', exist_ok=True)
        jobs_file = os.path.join('data', 'posted_jobs.json')
        with open(jobs_file, 'w', encoding='utf-8') as f:
            json.dump(JOBS_STORAGE, f, indent=2, ensure_ascii=False)
    except Exception as e:
        print(f"Failed to save jobs to file: {e}")

@app.route('/')
def health_check():
    """Simple health check endpoint"""
    return jsonify({
        'status': 'OK',
        'message': 'Job Posting API Server is running',
        'endpoints': {
            'jobs': 'GET/POST /api/jobs',
            'experiences': 'GET /api/experiences',
            'health': 'GET /'
        },
        'total_jobs': len(JOBS_STORAGE)
    })

@app.route('/api/jobs', methods=['GET', 'POST', 'OPTIONS'])
def api_jobs():
    """Handle job posting API requests"""
    if request.method == 'OPTIONS':
        return jsonify({'status': 'OK'})
    
    if request.method == 'GET':
        # Return list of jobs for frontend
        try:
            page = int(request.args.get('page', 1))
            limit = int(request.args.get('limit', 20))
            
            # Calculate pagination
            total = len(JOBS_STORAGE)
            start_idx = (page - 1) * limit
            end_idx = min(start_idx + limit, total)
            
            jobs_page = JOBS_STORAGE[start_idx:end_idx]
            
            print(f"Serving page {page} of jobs: {len(jobs_page)} jobs (total: {total})")
            
            return jsonify({
                'success': True,
                'jobs': jobs_page,
                'pagination': {
                    'page': page,
                    'limit': limit,
                    'total': total,
                    'pages': (total + limit - 1) // limit
                }
            })
            
        except Exception as e:
            print(f"Error fetching jobs: {e}")
            return jsonify({
                'success': False,
                'error': f'Failed to fetch jobs: {str(e)}'
            }), 500
    
    elif request.method == 'POST':
        # Handle job posting creation
        try:
            data = request.get_json()
            if not data:
                return jsonify({
                    'success': False,
                    'error': 'No data provided'
                }), 400
            
            # Validate required fields
            required_fields = ['title', 'company', 'description']
            for field in required_fields:
                if not data.get(field):
                    return jsonify({
                        'success': False,
                        'error': f'Missing required field: {field}'
                    }), 400
            
            # Create new job posting
            new_job = {
                'id': str(int(datetime.utcnow().timestamp())),
                'title': data.get('title'),
                'company': data.get('company'),
                'location': data.get('location', 'Not specified'),
                'description': data.get('description'),
                'salary': data.get('salary', 'Competitive'),
                'type': data.get('type', 'full-time'),
                'posted_date': datetime.utcnow().strftime('%Y-%m-%d'),
                'status': 'active',
                'requirements': data.get('requirements', []),
                'benefits': data.get('benefits', [])
            }
            
            # Add to storage
            JOBS_STORAGE.append(new_job)
            
            # Save to file
            save_jobs_to_file()
            
            print(f"New job posted: {new_job['title']} at {new_job['company']}")
            
            return jsonify({
                'success': True,
                'job': new_job,
                'message': 'Job posted successfully'
            })
            
        except Exception as e:
            print(f"Error creating job: {e}")
            return jsonify({
                'success': False,
                'error': f'Failed to create job posting: {str(e)}'
            }), 500

